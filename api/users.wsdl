<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/"
             xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="urn:users"
             targetNamespace="urn:users"
             xmlns="http://schemas.xmlsoap.org/wsdl/">

  <!-- Type definitions -->
  <types>
    <xsd:schema targetNamespace="urn:users">
      <xsd:import namespace="http://schemas.xmlsoap.org/soap/encoding/"/>
      <xsd:complexType name="UserArray">
        <xsd:complexContent>
          <xsd:restriction base="soapenc:Array">
            <xsd:attribute ref="soapenc:arrayType" wsdl:arrayType="xsd:string[]"/>
          </xsd:restriction>
        </xsd:complexContent>
      </xsd:complexType>
    </xsd:schema>
  </types>

  <!-- Message definitions -->
  <message name="usersRequest"/>

  <message name="usersResponse">
    <part name="return" type="tns:UserArray"/>
  </message>

  <!-- PortType definitions -->
  <portType name="UserPortType">
    <operation name="users">
      <input message="tns:usersRequest"/>
      <output message="tns:usersResponse"/>
    </operation>
  </portType>

  <!-- Binding definitions -->
  <binding name="UserBinding" type="tns:UserPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="users">
      <soap:operation soapAction="urn:users#users"/>
      <input>
        <soap:body use="encoded" namespace="urn:users" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </input>
      <output>
        <soap:body use="encoded" namespace="urn:users" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </output>
    </operation>
  </binding>

  <!-- Service definitions -->
  <service name="UserService">
    <port name="UserPort" binding="tns:UserBinding">
      <soap:address location="http://localhost:8000/server.php"/>
    </port>
  </service>

</definitions>
