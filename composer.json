{
    "name": "tolgahanacar/php-soap-ws",
    "description": "A modern OOP PHP SOAP Web Service demonstration using SoapServer, SoapClient and WSDL.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Tolgahan Acar"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-soap": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "disable-tls": true,
        "secure-http": false
    },
    "scripts": {
        "lint": [
            "php -l server.php",
            "php -l index.php",
            "php -l src/UserService.php",
            "php -l tests/SoapTest.php"
        ],
        "test": [
            "@lint",
            "php tests/SoapTest.php"
        ],
        "serve": "php -S localhost:8000"
    }
}
